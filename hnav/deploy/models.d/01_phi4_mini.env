# Phi-4-mini-instruct — campaign model 01 (smallest weights).   [E2E-5]
# Sourced by run_model_campaign.sh; see models.d/README.md for the rules.
MODEL_KEY=phi4_mini
MODEL_PATH=/mnt/nvmes/nvme1/models/Phi-4-mini-instruct
SERVED_NAME=microsoft/Phi-4-mini-instruct
VLLM_ENV=legacy                 # Phi3ForCausalLM is registered in vllm 0.9.1
# measured: longest sh_64k prompt = 43,321 tokens under this tokenizer + its
# chat template (169,810 chars, 3.92 chars/token) - the most efficient of the
# five models. 48k leaves 12% headroom.
MAX_MODEL_LEN=49152
GPU_MEM_UTIL=0.85
KV_CACHE_DTYPE=fp8
EXTRA_SERVE_FLAGS=""
NOTES="3.8B dense, Phi3 architecture, 131k native context, no thinking mode."
