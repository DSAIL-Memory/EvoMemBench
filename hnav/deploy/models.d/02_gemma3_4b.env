# gemma-3-4b-it — campaign model 02.                            [E2E-5]
# Sourced by run_model_campaign.sh; see models.d/README.md for the rules.
MODEL_KEY=gemma3_4b
MODEL_PATH=/mnt/nvmes/nvme1/models/gemma-3-4b-it
SERVED_NAME=google/gemma-3-4b-it
VLLM_ENV=legacy                 # Gemma3ForConditionalGeneration is in vllm 0.9.1
# measured: longest sh_64k prompt = 48,224 tokens (3.52 chars/token). This is
# ABOVE 48k, so a 48000-token server would have died mid-campaign on the
# longest question. 56k leaves 16% headroom; the extra KV costs ~0.2 GiB here.
MAX_MODEL_LEN=57344
GPU_MEM_UTIL=0.85
# BF16 KV, NOT the campaign's inherited fp8. This is measured, not cautionary:
# diagnose_serving.sh served these exact weights and flags twice on the same
# stack, varying only the cache dtype, and probed ten unique-stratum questions
# (single-fact retrieval, no conflict, nothing for H-Nav to do) -
#
#     legacy:fp8    0/10   ' [1920. \n'   vs 'shahnameh'
#     legacy:auto   9/10   'Shahnameh'    vs 'shahnameh'
#
# The first campaign run of this model used fp8 and scored 6-13/100 with
# looping output ("United States of United States of United States of United").
# That run is a broken instrument, not a model result, and is kept and labelled
# as such rather than deleted. Google's reference inference for Gemma-3 is
# BF16. Do not "optimize" this back to fp8.
KV_CACHE_DTYPE=auto
# Text-only benchmark: refuse image items rather than reserve encoder memory
# and profiling capacity for a modality no prompt uses.
EXTRA_SERVE_FLAGS='--limit-mm-per-prompt {"image":0}'
NOTES="4.3B multimodal checkpoint run text-only; 5:1 local/global attention, no thinking mode."
