# H-Nav configuration — ozonderlab2 (2× RTX 4090, driver 580.173.02 / CUDA 13.0)
#
# Copy to the REPO ROOT as `.env`:
#     cp hnav/deploy/ozonderlab2.env .env
#
# This is the repo-root .env, read by hnav/config.py and hnav/deploy/check_env.py.
# It is NOT the .env that MemoryAgentBench reads — that one is a separate file
# with a different OPENAI_BASE_URL. See hnav/deploy/mab.env.template and RUNBOOK.md §6.

# ── mode ─────────────────────────────────────────────────────────────────────
# off | shadow | live. Stage 0 runs off/shadow only; live is gated behind T8.
HNAV_MODE=off

# ── embedder → GPU1 ──────────────────────────────────────────────────────────
# GPU0 hosts your vLLM server (PID 52520, ~15.6 GB). Never allocate on it.
# GPU1 is idle with ~24.5 GB free; float32 needs ~17 GB, so it fits and the
# protocol default is preserved. Do NOT change dtype unless check_env.py says
# you must — dtype drift changes cosines and moves every threshold.
HNAV_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
HNAV_EMBED_DEVICE=1
HNAV_EMBED_DTYPE=float32
HNAV_EMBED_BATCH=32

# ── answer model → GPU0, your existing vLLM ──────────────────────────────────
# HNAV_LLM_MODEL must match what :8000 actually serves. check_env.py prints the
# served id and warns on mismatch — run it and correct this line if it differs.
HNAV_LLM_BASE_URL=http://localhost:8000/v1
HNAV_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
HNAV_LLM_TEMPERATURE=0
HNAV_LLM_MAX_TOKENS=128
HNAV_LLM_API_KEY=EMPTY

# ── NLI cross-encoder → GPU1 (read-gate stage 2, T9) ─────────────────────────
# ~1.7 GB fp32; fits on GPU1 next to the fp32 embedder (verified by
# check_env.py). check_env's smoke inference runs on CPU regardless.
HNAV_NLI_MODEL=cross-encoder/nli-deberta-v3-large
HNAV_NLI_DEVICE=1
HNAV_NLI_DTYPE=float32
HNAV_NLI_BATCH=16

# Embedding endpoint, GPU1, started by hnav/deploy/serve_embeddings.sh.
# NOT needed for T1/T2/T5/T7 (those embed in-process). REQUIRED for M0 and T4 —
# see RUNBOOK.md §6 for why NEXT_STEPS.md was wrong about this.
QWEN3_EMBED_BASE_URL=http://localhost:8001/v1

# ── paths (both gitignored) ──────────────────────────────────────────────────
HNAV_CACHE_DIR=hnav/_cache
HNAV_OUT_DIR=hnav/_out

# ── frozen signal parameters — changing these after calibration voids the freeze
HNAV_TOP_M=50
HNAV_CHURN_K=10
HNAV_WHITEN_MIN_FIT_N=200
HNAV_WHITEN_COMPONENTS=3

HNAV_RUN_ID=stage0
