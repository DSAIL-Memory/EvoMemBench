# H-Nav configuration.  Copy to the repo root as `.env` and edit.
#
#   cp hnav/deploy/.env.template .env
#
# The real process environment always wins over this file. `.env` is gitignored.

# ── mode ─────────────────────────────────────────────────────────────────────
# off | shadow | live.  DEFAULT off — a stray import must never change a number.
# Stage 0 (T0–T8) runs with off/shadow only; `live` is gated behind the T8 human
# decision and hnav/config.py:require_not_live() refuses it.
HNAV_MODE=off

# ── embedder (GPU1) ──────────────────────────────────────────────────────────
# GPU0 hosts the LLM server. Never point the embedder at it.
# The embedder chosen in T1 must be used unchanged in every later task —
# mixing embedders invalidates the calibration.
HNAV_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
HNAV_EMBED_DEVICE=1
HNAV_EMBED_DTYPE=float32
HNAV_EMBED_BATCH=32

# ── answer model (GPU0, local vLLM, OpenAI-compatible) ───────────────────────
# There is no external API and no API key. Temperature 0 is required: the
# shadow-neutrality test has no legitimate source of variation at t=0.
HNAV_LLM_BASE_URL=http://localhost:8000/v1
HNAV_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
HNAV_LLM_TEMPERATURE=0
HNAV_LLM_MAX_TOKENS=128
HNAV_LLM_API_KEY=EMPTY

# Optional: served embedding endpoint (hnav/deploy/serve_embeddings.sh).
# Not needed for T1 — M1 loads the embedder in-process.
QWEN3_EMBED_BASE_URL=http://localhost:8001/v1

# ── paths (both gitignored) ──────────────────────────────────────────────────
HNAV_CACHE_DIR=hnav/_cache
HNAV_OUT_DIR=hnav/_out

# ── frozen signal parameters ─────────────────────────────────────────────────
# Changing any of these after the calibration split is fit invalidates the
# freeze (protocol §6).
HNAV_TOP_M=50                # neighbourhood depth for H_z / H_vn / dispersion
HNAV_CHURN_K=10              # k in churn@k
HNAV_WHITEN_MIN_FIT_N=200    # refuse ABTT below this store size (plan §3)
HNAV_WHITEN_COMPONENTS=3     # ABTT "all but the top" D

# Identifier stamped into every audit record.
HNAV_RUN_ID=stage0
